{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [        
         {
            "name": ".NET Core Launch (Blazor Standalone)",
            "type": "coreclr",
            "request": "launch",
            "program": "dotnet",
            "args": [
                "run"
            ],
            "cwd": "${workspaceFolder}/Gestao.App/Gestao.App",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "C#: Gestao.App Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/Gestao.App/Gestao.App"
        },
        {
            "name": "Launch and Debug Hosted Blazor WebAssembly App",
            "type": "blazorwasm",
            "request": "launch",
            "hosted": true,
            "program": "${workspaceFolder}/Gestao.App/Gestao.App/bin/Debug/net10.0/Gestao.App.dll",
            "cwd": "${workspaceFolder}/Gestao.App/Gestao.App"
        }
    ]
}