@rendermode InteractiveServer

   
<MudIconButton Icon="@Icons.Material.Filled.Menu" 
                    Color="Color.Inherit" 
                    Edge="Edge.Start" 
                    OnClick="@OnClickToggle" />

<MudText Typo="Typo.h6">Nine Goldy</MudText>

<MudSpacer />

<MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" />

<MudLink href="/account/login" Color="Color.Inherit" >
    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" />
</MudLink>



@code {

    [Parameter]
    public EventHandler OpenDrawer { get; set; }

    private async Task OnClickToggle(MouseEventArgs args)
    {
        OpenDrawer?.Invoke(this, EventArgs.Empty);
    }

}
