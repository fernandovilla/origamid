
@inherits LayoutComponentBase

@* Required *@
<MudThemeProvider />
<MudPopoverProvider />
@* Needed for dialogs *@
<MudDialogProvider />
@* Needed for snackbars *@
<MudSnackbarProvider />

<MudLayout>
    
    <MudMenuLayout />
    
    <MudMainContent>
        <div class="px-4 py-4">
            @Body
        </div>
    </MudMainContent>

    @*<MudFooter Elevation="1">
        Desenvolvido por NineGoldy Soluções
    </MudFooter>*@
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    private bool _sideMenuOpen = true;

    private async void OpenDrawer(object sender, EventArgs e)
    {
        _sideMenuOpen = !_sideMenuOpen;
        StateHasChanged();
    }
}
