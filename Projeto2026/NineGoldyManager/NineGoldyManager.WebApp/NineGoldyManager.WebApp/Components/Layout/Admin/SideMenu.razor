@rendermode InteractiveServer

<MudDrawerHeader Dense="true" class="px-4 py-0">
    <div class="d-flex flex-column" style="width:100%">
        <MudText Typo="Typo.h6">NineGoldy</MudText>
        <MudText Typo="Typo.body2" mud-text-secondary">Soluções</MudText>
        <MudDivider />
    </div>
</MudDrawerHeader>

<MudNavMenu Class="mud-width-full" Bordered="true" Color="Color.Primary" MultiExpansion="true" Dense="true">    
    <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/autorized-page" Icon="@Icons.Material.Filled.Lock">Autorizada</MudNavLink>

    <MudNavGroup Title="Cadastros" Icon="@Icons.Material.Filled.Settings" @bind-Expanded="@CadastrosExpanded">
        <MudNavLink Href="/lista-cliente" Icon="@Icons.Material.Filled.People" IconColor="Color.Success">Clientes</MudNavLink>
        <MudNavLink Href="/lista-servicos" Icon="@Icons.Material.Filled.Security" IconColor="Color.Info">Serviços</MudNavLink>
    </MudNavGroup>

    <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings" Expanded="false">
        <MudNavLink Href="/profile" Icon="@Icons.Material.Filled.People" IconColor="Color.Success">Perfil</MudNavLink>
        <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Security" IconColor="Color.Info">Parâmetros</MudNavLink>
    </MudNavGroup>
</MudNavMenu>

@code {

    [Parameter]
    public bool Open { get; set; }

    private bool CadastrosExpanded { get; set; } = false;
    
}
