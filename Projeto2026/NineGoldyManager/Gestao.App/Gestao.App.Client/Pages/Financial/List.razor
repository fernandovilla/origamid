@page "/financial/{type}/list"

@attribute [Authorize]
@rendermode InteractiveAuto
@inject IFinancialTransactionRepository FinancialTransactionRepository
@inject ILocalStorageService LocalStorage

<PageTitle>
    Transações Financeiras
</PageTitle>

<div class="card">

    <div class="card-header align-items-center d-flex">

        <h4 class="card-title mb-0 flex-grow-1">
            @if (TypeEnum == FinancialTransactionTypeEnum.Pay)
            {
                <i class="ri-currency-line me-1" />
                <span>Contas à Pagar</span>
            }
            else
            {
                <i class="ri-hand-heart-line me-1" />
                <span>Contas à Receber</span>
            }
        </h4>
        <div class="flex-shrink-0">
            <a href="/financial/@Type/add" class="btn btn-info btn-sm material-shadow-none">
                <i class="ri-add-circle-line me-1" />nova transação
            </a>
        </div>
    </div><!-- end card header -->

    <div class="card-body">

        <!-- Pesquisa -->
        <div class="col-lg-8">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Digite sua pesquisa" @bind="SearchWord">
                <button class="btn btn-outline-success" type="button"><i class="ri-search-line" @onclick="OnSearchAsync" /></button>
            </div>
        </div>

        <div class="table-responsive table-card-company mt-4">
            <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                <thead class="text-muted table-light">
                    <tr>
                        <th scope="col">Data Competência</th>
                        <th scope="col">Descrição</th>
                        <th scope="col">Valor</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Transactions == null)
                    {
                        <tr>
                            <td colspan="4">Carregando...</td>
                        </tr>
                    }
                    else if (Transactions.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="4">Nenhuma transação registrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var transaction in Transactions.Items)
                        {
                            <tr>
                                <td>
                                    @transaction.ReferenceDate!.Value.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @transaction.Description
                                    @if(transaction.Documents?.Count > 0)
                                    {                                        
                                        <i class="las la-paperclip mx-2" />                                                                                
                                    }
                                </td>
                                <td>
                                    @ValueAmount(transaction.AmountPaid, transaction.Amount)
                                    @if (transaction.AmountPaid.HasValue)
                                    {
                                        <span class="badge badge-label bg-success mx-3" data-key="t-hot">PAGO</span>
                                    }
                                </td>
                                <td>
                                    <a href="/financial/@Type/edit/@transaction.Id" class="btn btn-sm btn-soft-info"><i class="ri-edit-line" /></a>
                                    <a href="/financial/@Type/detail/@transaction.Id" class="btn btn-sm btn-soft-danger"><i class="ri-delete-bin-line" /></a>                                    
                                </td>
                            </tr>
                        }
                    }

                    <!-- end tr -->
                </tbody><!-- end tbody -->
            </table><!-- end table -->
        </div>

        @if (Transactions != null)
        {
            <Pagination PaginatedData=@Transactions OnPageChanged=@OnPageChanged />
        }

    </div>

	
</div>

<style>
    .table-card-company {
        margin-left: -16px;
        margin-right: -16px;
    }
</style>


@code {
    [Parameter]
    public string? Type { get; set; }

    public FinancialTransactionTypeEnum TypeEnum => (Type?.ToUpper() == "PAY" ? FinancialTransactionTypeEnum.Pay : FinancialTransactionTypeEnum.Receive);

    public string TypeDescription => (TypeEnum == FinancialTransactionTypeEnum.Pay ? "À Pagar" : "À Receber");

    private PaginatedList<FinancialTransaction>? Transactions = null;
    private Company? Company = null;
    private int PageSize = 15;
    private int PageIndex = 1;
    private string SearchWord = string.Empty;

    private async Task OnPageChanged(int pageNumber)
    {
        PageIndex = pageNumber;
        await LoadDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        //await LoadAuthenticatedUserAsync();
        //await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadDataAsync();

        StateHasChanged();
    }

    private async Task OnSearchAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        if (Company == null)
            Company = await LocalStorage.GetItemAsync<Company>(AppConstants.LOCAL_STORAGE_COMPANY);


        if (Company != null)
            Transactions = await FinancialTransactionRepository.GetAllAsync(Company.Id, TypeEnum, PageIndex, PageSize, SearchWord);
    }

    private string ValueAmount(decimal? amountPaid, decimal? amount)
    {
        if (amountPaid != null && amountPaid > 0)
            return amountPaid.Value.ToString("C");

        if (amount != null && amount > 0)
            return amount.Value.ToString("C");

        return "-";
    }
}
