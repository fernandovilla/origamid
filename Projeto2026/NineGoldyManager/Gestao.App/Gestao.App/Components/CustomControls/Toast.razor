@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="toast-container position-fixed rounded @PositionCss p-3">
    <div @ref="_toastElement"
         class="toast align-items-center"
         role="alert"
         aria-live="assertive"
         aria-atomic="true">

        <div class="toast-header @ClassHeader">
            @if (!string.IsNullOrWhiteSpace(ImageSrc))
            {
                <img src="@ImageSrc" class="rounded me-2" alt="@ImageAlt" style="width:20px;height:20px;object-fit:cover;" />
            }

            <strong class="me-auto">@Title</strong>

            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <small>@Subtitle</small>
            }
            <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Fechar"></button>
        </div>

        @if(ChildContent is not null || !string.IsNullOrEmpty(Message))
        {
            <div class="toast-body @ClassBody">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    @Message
                }
            </div>
        }        
    </div>
</div>

@code {
    private ElementReference _toastElement;
    private IJSObjectReference? _module;

    /// <summary>Título exibido no cabeçalho.</summary>
    [Parameter] public string Title { get; set; } = "Notificação";

    /// <summary>Texto auxiliar do cabeçalho (ex.: "agora", "11 min atrás").</summary>
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Mensagem simples do corpo. Ignorada se ChildContent for informado.</summary>
    [Parameter] public string? Message { get; set; }

    /// <summary>Conteúdo customizado (HTML/Razor) do corpo.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>URL da imagem do cabeçalho (opcional).</summary>
    [Parameter] public string? ImageSrc { get; set; }

    [Parameter] public string ImageAlt { get; set; } = "";

    /// <summary>Classes extras no toast. Ex.: "text-bg-success", "text-bg-danger".</summary>
    [Parameter] public string? ClassHeader { get; set; }
    [Parameter] public string? ClassBody { get; set; }

    /// <summary>Posição do container. Ex.: "bottom-0 end-0", "top-0 end-0", "top-0 start-50 translate-middle-x".</summary>
    [Parameter] public string PositionCss { get; set; } = "bottom-0 end-0";

    /// <summary>Fechar automaticamente após o delay.</summary>
    [Parameter] public bool AutoHide { get; set; } = true;

    /// <summary>Tempo em ms até esconder automaticamente.</summary>
    [Parameter] public int Delay { get; set; } = 5000;

    /// <summary>Aplica animação de fade.</summary>
    [Parameter] public bool Animation { get; set; } = true;

    private async Task<IJSObjectReference> GetModuleAsync() 
    {
        if (_module is null)
             _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/CustomControls/Toast.razor.js");

        return _module;
    }

    public async Task ShowAsync()
    {
        var module = await GetModuleAsync();

        await module.InvokeVoidAsync("show", _toastElement, new
        {
            autohide = AutoHide,
            delay = Delay,
            animation = Animation
        });
    }

    public async Task HideAsync()
    {
        var module = await GetModuleAsync();
        await module.InvokeVoidAsync("hide", _toastElement);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _toastElement);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) 
            { 
                /* circuito já encerrado (Blazor Server) */ 
            }
        }
    }
}