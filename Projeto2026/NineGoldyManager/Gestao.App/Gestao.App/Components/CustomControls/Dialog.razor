@using Microsoft.FluentUI.AspNetCore.Components
@inject IJSRuntime JS
@implements IAsyncDisposable

<dialog @ref="dialogRef" class="confirm-dialog" aria-labelledby="dialog-title">
    <div class="d-flex align-center">
        @if(IconVisible) {
            <div class="icon mr-2">            
                <i class="@IconText"></i>
            </div>
        }
        <h3 id="dialog-title" class="dialog-title">@Title</h3>        
    </div>
    <p class="dialog-message">@Message</p>

    <div class="dialog-actions">

        @if (DialogStyle == DialogStyleEnum.Question)
        {
            <button type="button" class="btn btn-secondary" @onclick="() => CloseAsync(false)">@NoText</button>
            <button type="button" class="btn btn-primary" autofocus @onclick="() => CloseAsync(true)">@YesText</button>
        } 
        else 
        {
            <button type="button" class="btn btn-primary" autofocus @onclick="() => CloseAsync(false)">Ok</button>
        }
    </div>
</dialog>

<style>
    .confirm-dialog {
        border: none;
        border-radius: 8px;
        padding: 1.5rem;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
        margin: auto auto;
    }

    .confirm-dialog::backdrop {
        background: rgba(0, 0, 0, 0.5);
    }

    .dialog-title {
        margin: 0 0 0.75rem;
        font-size: 1.25rem;
    }

    .dialog-message {
        margin: 0 0 1.5rem;
    }

    .dialog-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .icon {
        width: 32px;
        height: 32px;
        font-size: 2rem;;
    }

    .icon i {
        @* font-size: 2rem; *@
    }

    .icon .critical {
        color: red;
    }

    .icon .warning {
        color: orange;
    }
    .icon .info, 
    .icon .question {
        color: blue;
    }


</style>

@code {
    [Parameter] public string Title { get; set; } = "Confirmação";
    [Parameter] public string Message { get; set; } = "Deseja continuar?";
    [Parameter] public string YesText { get; set; } = "Sim";
    [Parameter] public string NoText { get; set; } = "Não";    

    /// <summary>Se true, clicar no fundo escurecido equivale a "Não".</summary>
    [Parameter] public bool CloseOnBackdropClick { get; set; } = false;    
    [Parameter] public EventCallback<bool?> OnResult { get; set; }

    private ElementReference dialogRef;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Dialog>? _self;
    private TaskCompletionSource<bool?>? _tcs;

    private DialogStyleEnum DialogStyle {get;set;} = DialogStyleEnum.Ok;
    private bool IconVisible {get;set;} = false;
    private string IconText { get; set; } = string.Empty;


    private void SetIcon(DialogIconEnum icon)
    {
        if (icon == DialogIconEnum.None)
        {
            IconVisible = false;        
        } 
        else
        {
            IconVisible = true;
            switch (icon)
            {
                case DialogIconEnum.Information: IconText = "ri-error-warning-fill text-info"; break;
                case DialogIconEnum.Exclamation: IconText = "ri-alert-fill text-warning"; break;
                case DialogIconEnum.Question: IconText = "ri-question-fill text-primary"; break;
                case DialogIconEnum.Critical: IconText = "ri-spam-fill text-danger"; break;
            }
        }
    }

    /// <summary>
    /// Abre o modal e aguarda a escolha do usuário.
    /// Retorna true para "Sim" e false para "Não" (ou Esc).
    /// </summary>
    public async Task<bool?> ShowAsync()
    {
        // Se já houver um modal aberto, conclui o anterior como "Não"
        _tcs?.TrySetResult(false);
        _tcs = new TaskCompletionSource<bool?>(TaskCreationOptions.RunContinuationsAsynchronously);

        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/CustomControls/Dialog.razor.js");

        _self ??= DotNetObjectReference.Create(this);

        await InvokeAsync(StateHasChanged); // aplica Title/Message antes de abrir
        await _module.InvokeVoidAsync("show", dialogRef, _self, CloseOnBackdropClick);

        return await _tcs.Task;
    }

    public Task<bool?> ShowAsync(string title, string message, DialogStyleEnum style = DialogStyleEnum.Ok, DialogIconEnum icon = DialogIconEnum.None)
    {
        Title = title;
        Message = message;
        DialogStyle = style;

        SetIcon(icon);

        return ShowAsync();
    }

    private async Task CloseAsync(bool? result)
    {
        if (_module is not null)
            await _module.InvokeVoidAsync("close", dialogRef);

        await CompleteAsync(result);
    }

    /// <summary>Chamado pelo JS quando o usuário aperta Esc ou clica no fundo.</summary>
    [JSInvokable]
    public async Task OnDismissed() => await CompleteAsync(false);

    private async Task CompleteAsync(bool? result)
    {
        if (_tcs is { Task.IsCompleted: false })
        {
            _tcs.TrySetResult(result);
            await OnResult.InvokeAsync(result);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _tcs?.TrySetResult(false); // evita await pendurado se o componente for destruído
        _self?.Dispose();

        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}