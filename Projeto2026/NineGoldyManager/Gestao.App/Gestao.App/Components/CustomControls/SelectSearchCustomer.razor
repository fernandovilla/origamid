@using Humanizer
@inject AuthenticationStateProvider AuthProvider
@inject IApplicationUserService ApplicationUserService
@inject ICustomerService CustomerService

<SelectSearch DisplayText="@DisplayText" OnSearching="OnSearchingClientesAsync" DelaySeconds="1" ShowMenu="@ShowMenu">
    @if (Customers != null)
    {
        @foreach (var customer in Customers)
        {
            <a class="select-search-item" @onclick="@(() => OnSelectCustomer(customer))">@customer.Name</a>
        }
    }
</SelectSearch>

<style>
    .select-search-item {
        padding: 10px;
        color: black;
        cursor: pointer;
    }

    .select-search-item:hover {
        border-radius: 4px;
        background-color: rgba(0, 0, 0, 0.05);
        color: black;
    }
</style>


@code {
    [Parameter] public EventCallback<Customer> SelectedCustomer { get; set; }
    [Parameter] public string DisplayText { get; set; } = "Selecione o cliente...";    
    [Parameter] public bool OnlyCompanyCustomers {get;set;} = false;

    private Guid? CompanyId { get; set; }
    private bool? ShowMenu { get; set; } = null;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            ShowMenu = false;
    }

    override protected async Task OnInitializedAsync()
    {
        await LoadAuthenticatedUser();
    }

    private async Task LoadAuthenticatedUser()
    {
        var userId = (await AuthenticationHelper.GetAuthenticatedUserIdAsync(AuthProvider))!.Value;

        if (userId != Guid.Empty)
        {
            var user = await ApplicationUserService.FindByIdAsync(userId);
            CompanyId = user.CompanyId;
        }
    }
    

    private IQueryable<Customer> Customers { get; set; }

    private async Task OnSearchingClientesAsync(string value)
    {
        if (string.IsNullOrEmpty(value) || (CompanyId == null && OnlyCompanyCustomers)) 
            Customers = null;
        else
            Customers = await CustomerService.FindByNameAsync(CompanyId, value);

        StateHasChanged();
    }

    private async Task OnSelectCustomer(Customer customer)
    {
        ShowMenu = false;
        DisplayText = customer.Name;
        //await SelectedCustomer.InvokeAsync(customer);
        StateHasChanged();
    }
}