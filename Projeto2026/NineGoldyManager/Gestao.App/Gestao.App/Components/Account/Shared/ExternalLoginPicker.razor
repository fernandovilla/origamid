@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Gestao.App.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@if (externalLogins.Length == 0)
{
    <div>
        <p>
            There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">
            article
            about setting up this ASP.NET application to support logging in via external services
        </a>.
    </p>
</div>
}
else
{
    <form class="form-horizontal" action="Account/PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <p>
                @foreach (var provider in externalLogins)
                {
                    switch (provider.Name.ToUpper())
                    {
                        case "GOOGLE":
                            <button type="submit" name="provider" value="@provider.Name" title="Faça login usando @provider.DisplayName" class="btn btn-danger btn-icon waves-effect waves-light mx-1"><i class="ri-google-fill fs-16"></i></button>
                            break;
                        case "FACEBOOK":
                            <button type="submit" name="provider" value="@provider.Name" title="Faça login usando @provider.DisplayName" class="btn btn-primary btn-icon waves-effect waves-light mx-1"><i class="ri-facebook-fill fs-16"></i></button>
                            break;
                        case "MICROSOFT":
                            <button type="submit" name="provider" value="@provider.Name" title="Faça login usando @provider.DisplayName" class="btn btn-dark btn-icon waves-effect waves-ligh  mx-1"><i class="ri-microsoft-fill fs-16"></i></button>
                            break;
                        case "TWITTER":
                            <button type="submit" name="provider" value="@provider.Name" title="Faça login usando @provider.DisplayName" class="btn btn-info btn-icon waves-effect waves-light mx-1"><i class="ri-twitter-fill fs-16"></i></button>
                            break;
                        case "GITHUB":
                            <button type="submit" name="provider" value="@provider.Name" title="Faça login usando @provider.DisplayName" class="btn btn-dark btn-icon waves-effect waves-light mx-1"><i class="ri-github-fill fs-16"></i></button>
                            break;
                        default:
                            <button type="submit" name="provider" value="@provider.Name" title="Faça login usando @provider.DisplayName" class="btn btn-primary waves-effect waves-light mx-1" />
                            break;
                    }
                }
            </p>
        </div>
    </form>
}


@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }


    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();      
    }
}
