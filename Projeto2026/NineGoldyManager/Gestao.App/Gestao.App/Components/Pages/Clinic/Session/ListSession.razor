@using Gestao.Domain.Libraries.Utilities
@inject ISessionService SessionService 

<div class="table-responsive mt-4 table-list">
    <table class="table table-borderless table-centered align-middle table-nowrap mb-0 table-container">
        <thead class="text-muted table-light">
            <tr>
                @if(!HideName){
                    <th scope="col">Cliente</th>
                }
                <th scope="col">Data Sessão</th>
                <th scope="col">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Sessions == null && Loading)
            {
                <tr>
                    <td colspan="4">Carregando...</td>
                </tr>
            }            
            else if ((Sessions == null || Sessions.Items.Count == 0) && !Loading )
            {
                <tr>
                    <td colspan="4">Nenhuma sessão registrada</td>
                </tr>
            }
            else
            {
                @foreach (var session in Sessions.Items)
                {
                    <tr>
                        @if(!HideName) {
                            <td>
                                <a @onclick="() => OnEditSessionAsync(session)" style="width:100%; display:block">@session.Customer?.Name</a>
                            </td>
                        }
                        <td>@session.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a @onclick="() => OnEditSessionAsync(session)" class="btn btn-sm btn-soft-info icon-action"><i class="ri-edit-line"></i></a>
                            <a @onclick="() => OnDeleteSessionAsync(session)" class="btn btn-sm btn-soft-danger icon-action"><i class="ri-delete-bin-line"></i></a>
                        </td>
                    </tr>
                }
            }

            <!-- end tr -->
        </tbody><!-- end tbody -->
    </table><!-- end table -->
</div>

@code {

    [Parameter] public IPaginatedList<Session>? Sessions {get;set;}
    [Parameter] public bool Loading {get;set;} = false;
    [Parameter] public bool HideName { get;set;}  = false;
    [Parameter] public EventCallback<Session> EditSessionAsync { get; set;}
    [Parameter] public EventCallback<Session> DeleteSessionAsync { get; set;}



    private async Task OnEditSessionAsync(Session session)
    {
        await EditSessionAsync.InvokeAsync(session);
    }

    private async Task OnDeleteSessionAsync(Session session)
    {
        await DeleteSessionAsync!.InvokeAsync(session);
    }
}