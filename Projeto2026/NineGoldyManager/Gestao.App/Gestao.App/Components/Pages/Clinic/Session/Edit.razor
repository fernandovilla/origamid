@page "/clinic/session/edit"
@page "/clinic/session/edit/{id:Guid}"
@using Gestao.App.CustomControls

@rendermode InteractiveServer
@inherits AuthenticatedPageBase

<PageTitle>
    Registro de Sessão - Estética
</PageTitle>

<h5 class="mb-2">
    @(Id == null ? "Nova Sessão" : "Edição Sessão")
</h5>

@* SELEÇÃO DO CLIENTE *@

<div class="overflow-y-visible overflow-x-visible">

    <MudFocusTrap>
    
        <EditForm Model=@Model OnValidSubmit="OnSubmitAsync" FormName="UpdateModel">

            <Morris.Blazor.Validation.Validate />

            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header align-items-center d-flex">
                            <h6 class="card-title mb-0 flex-grow-1">Dados da Sessão</h6>
                        </div>
                        <div class="card-body">

                            <div class="row">
                                <div class="col-12 col-xxl-6">
                                    <label for="customer" class="form-label">Cliente</label>
                                    <SelectSearchCustomer CompanyId="base.AuthenticatedUser?.CompanyId" SelectedCustomer="SelectedCustomerAsync" />
                                </div>                                

                                <div class="col-xxl-2 col-md-6">
                                    <label for="sessionDate" class="form-label">Data Sessão</label>
                                    <InputDate @bind-Value="Model!.SessionDate" class="form-control" id="sessionDate" />
                                    <ValidationMessage For="() => Model!.SessionDate" />
                                </div>

                                <div class="col-12">
                                    <label for="obs" class="form-label">Procedimento</label>
                                    <InputTextArea @bind-Value="Model!.Observation" class="form-control" id="obs" rows="10" />
                                    <ValidationMessage For="() => Model!.Observation" />
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="card">
                        <div class="card-header align-items-center d-flex">
                            <h6 class="card-title mb-0 flex-grow-1">Assinatura do Cliente</h6>
                        </div>
                        <div class="card-body">
                            <SignaturePad @bind-Value="Model!.Signature" ConfirmedImage="ConfirmedImageAsync" />
                        </div>
                    </div>
                </div>
            </div>

              <div class="row mt-3">
                <div class="d-flex justify-content-start">
                    <a href="customer/list" class="btn btn-light mr-2" @onclick="RollbackDataAsync">Voltar</a>
                    <ButtonSave type="submit"/>
                </div>
            </div>
        </EditForm>
    </MudFocusTrap>
</div>



@code {
    [Parameter] public Guid? Id { get; set; }

    private Customer? Customer{get;set;}
    private Session? Model { get; set; }
    private SessionModelTypeEnum? ModelType { get; set; } = SessionModelTypeEnum.None;
    private string? ModelCode { get; set; } = "";
    private string? JsonSession { get; set; } = "";
    //private ApplicationUser? User;

    protected override void OnInitialized()
    {
        LoadAuthenticatedUser();
    }

    private void LoadAuthenticatedUser()
    {
        //User = base.AuthenticatedUser;
    }

    protected override async Task OnInitializedAsync()
    {
        Model ??= new();

        ModelType = SessionModelTypeEnum.MedicalSpa;
        ModelCode = "0001";
        JsonSession = "{ model: '0001' }";
    }

    private async Task OnSubmitAsync()
    {
        await JSRuntime.InvokeVoidAsync("alert", "Registrado!");
        await JSRuntime.InvokeVoidAsync("alert", Model.Signature);
    }

    private async Task TesteAsync()
    {
        await JSRuntime.InvokeVoidAsync("alert", "teste");
    }

    private async Task SelectedCustomerAsync(Customer customer)
    {
        //await JSRuntime.InvokeVoidAsync("alert", customer.Name);
        Model.Customer= customer;
        Model.CustumerId = customer.Id;
    }

    private async Task RollbackDataAsync()
    {
        //DbContext.ChangeTracker.Clear();
    }

    private async Task ConfirmedImageAsync(string? image)
    {
        Model.Signature = image;
    }
}