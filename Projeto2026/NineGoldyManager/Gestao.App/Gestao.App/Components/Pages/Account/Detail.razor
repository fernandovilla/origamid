@page "/Account/Detail/{id:int}"

@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime js
@inject IAccountRepository AccountRepository

<PageTitle>
    Conta - Detalhe
</PageTitle>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">
                    Detalhes da Conta
                </h4>

            </div>
            <div class="card-body">

                <div class="row">

                    <div class="col-xxl-6 col-md-6">
                        <div>
                            <label for="description" class="form-label">Descrição/Nome</label>
                            <p>@Account!.Description</p>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-xxl-3 col-md-6">
                        <div>
                            <label for="balance" class="form-label">Saldo Inicial</label>
                            <p>@Account!.Balance.ToString("0.00")</p>
                        </div>
                    </div>

                    <div class="col-xxl-3 col-md-6">
                        <div>
                            <label for="cnpj" class="form-label">CNPJ</label>
                            <p>@Account!.BalanceDate!.ToString("dd/MM/yyyy")</p>
                        </div>
                    </div>
                </div>


                <div class="row mt-2">
                    <div class="d-flex justify-content-between">
                        <a href="/account/list" class="btn btn-light">Voltar</a>
                        <button @onclick="OnClickAsync" class="btn btn-danger"><i class="ri-delete-bin-line" />Excluir</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>



@code {

    [Parameter]
    public Guid? Id { get; set; }
    private Account Account { get; set; }


    private async Task OnClickAsync()
    {
        await AccountRepository.DeleteAsync(Account.Id);

        await js.InvokeVoidAsync("alert", "Conta excluída com sucesso!");

        NavigationManager.NavigateTo("/account/list");
    }

    
    protected override void OnInitialized()
    {
        Account = new();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id == null)
        {
            //TODO - SELECIONA OS DADOS DO REPOSITORY
            var account = (await AccountRepository.GetAsync((Guid)Id))!;

            if (account == null)
            {
                NavigationManager.NavigateTo("/account/list");
                return;
            }

            Account = account;
        }
    }
}
