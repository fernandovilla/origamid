@page "/customer/list"
@using Gestao.Domain.Libraries.Utilities

@inherits AuthenticatedPageBase
@inject ICustomerService CustomerService


<PageTitle>
    Clientes
</PageTitle>

<div class="card">

    <div class="card-header align-items-center d-flex">

        <h4 class="card-title mb-0 flex-grow-1">
            <i class="ri-contacts-line me-1" />Clientes
        </h4>
        <div class="flex-shrink-0">
            <a href="/customer/edit" class="btn btn-info btn-sm material-shadow-none">
                <i class="ri-user-add-line me-1" />novo cliente
            </a>
        </div>
    </div><!-- end card header -->

    <div class="card-body">

        <!-- Pesquisa -->
        <div class="col-lg-8">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Digite sua pesquisa" @bind="SearchWord">
                <button class="btn btn-outline-success" type="button"><i class="ri-search-line" @onclick="OnSearch" /></button>
            </div>
        </div>

        <div class="table-responsive mt-4 table-card-company">
            <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                <thead class="text-muted table-light">
                    <tr>
                        <th scope="col">Nome</th>
                        <th scope="col">Documento</th>
                        <th scope="col">Endereço</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Customers == null)
                    {
                        <tr>
                            <td colspan="4">Carregando...</td>
                        </tr>
                    }
                    else if (Customers.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="4">Nenhuma empresa cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var customer in Customers.Items)
                        {
                            <tr>
                                <td>
                                    @customer.Name
                                    @* @if (CompanySelected != null && CompanySelected.Id == customer.Id)
                                    {
                                        <span class="badge badge-label bg-success mx-3" data-key="t-hot">SELECIONADA</span>
                                    } *@
                                </td>
                                <td>@customer.Document</td>
                                <td>@customer.Address</td>
                                <td>
                                    @* @if (CompanySelected != null && CompanySelected.Id == customer.Id)
                                    {
                                        <button class="btn btn-sm btn-soft-danger me-1" @onclick="() => RemoveCompanyAsync(customer)"><i class="ri-close-line me-1" />Remover</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-soft-success me-1" @onclick="() => SelectCompanyAsync(customer)"><i class="ri-check-line me-1" />Selecionar</button>
                                    } *@

                                    <a href="/customer/edit/@customer.Id" class="btn btn-sm btn-soft-info"><i class="ri-edit-line" /></a>
                                    <a href="/customer/detail/@customer.Id" class="btn btn-sm btn-soft-danger"><i class="ri-delete-bin-line" /></a>
                                </td>
                            </tr>
                        }
                    }

                    <!-- end tr -->
                </tbody><!-- end tbody -->
            </table><!-- end table -->
        </div>

        @* <Pagination PaginatedData="Customers" OnPageChanged="OnPageChanged" /> *@
    </div>

	
</div>

<style>
    .table-card-company {
        margin-left: -16px;
        margin-right: -16px;
    }
</style>

@code {
    private IPaginatedList<Customer> Customers { get; set; }
    private int PageIndex = 1;
    private int PageSize = 15;
    private ApplicationUser User;

    private string SearchWord { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await LoadAuthenticatedUserAsync();
        await LoadDataAsync();
    }

    private async Task LoadAuthenticatedUserAsync()
    {        
        var userId = (await AuthenticationHelper.GetAuthenticatedUserIdAsync(AuthProvider))!.Value;

        if (userId != Guid.Empty)
            User = await ApplicationUserService.FindByIdAsync(userId);
    }


    private async Task OnPageChanged(int pageNumber)
    {
        PageIndex = pageNumber;
        StateHasChanged();
    }


    private async Task LoadDataAsync()
    {
        if (User == null)
            return;

        Customers = await CustomerService.ListAsync((Guid)User.CompanyId, PageIndex, PageSize, SearchWord);
    }

    private async Task OnSearch()
    {
        PageIndex = 1;
        await LoadDataAsync();
    }
}
