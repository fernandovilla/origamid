@page "/customer/list"
@using Gestao.Domain.Libraries.Utilities

@rendermode InteractiveServer

@inherits AuthenticatedPageBase
@inject ICustomerService CustomerService


<PageTitle>
    Clientes
</PageTitle>

<div style="height:calc(100vh - 90px);overflow:hidden;">
    <div class="card">

        <div class="card-header align-items-center d-flex">

            <h4 class="card-title mb-0 flex-grow-1">
                <i class="ri-contacts-line me-1" />Clientes
            </h4>
            <div class="flex-shrink-0">
                <a href="/customer/edit" class="btn btn-info btn-sm material-shadow-none">
                    <i class="ri-user-add-line me-1" />novo cliente
                </a>
            </div>
        </div><!-- end card header -->

        <div class="card-body">

            <!-- Pesquisa -->
            <div class="col-lg-8">
                <div class="input-group">
                    <input type="text" class="form-control" placeholder="Digite sua pesquisa" @bind="SearchWord" @oninput="OnInput">
                    <button class="btn btn-outline-success" type="button"><i class="ri-search-line" @onclick="OnSearch"  /></button>
                </div>
            </div>

            <div class="table-responsive mt-4 table-card-company">
                <table class="table table-borderless table-centered align-middle table-nowrap mb-0 table-container">
                    <thead class="text-muted table-light">
                        <tr>
                            <th scope="col">Nome</th>
                            <th scope="col">Tipo Pessoa</th>
                            <th scope="col">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Customers == null)
                        {
                            <tr>
                                <td colspan="4">Carregando...</td>
                            </tr>
                        }
                        else if (Customers.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="4">Nenhuma empresa cadastrada</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var customer in Customers.Items)
                            {
                                <tr>
                                    <td>
                                        <a href="/customer/edit/@customer.Id" style="width:100%;display:block">
                                            @customer.Name
                                        </a>
                                    </td>
                                    <td>@(customer.TipoPessoa == TipoPessoaEnum.PessoaFisica ? "Pessoa Física" : "Pessoa Jurídica")</td>
                                    <td>                                        
                                        <a href="/customer/edit/@customer.Id" class="btn btn-sm btn-soft-info icon-action"><i class="ri-edit-line" /></a>
                                        <a href="/customer/detail/@customer.Id" class="btn btn-sm btn-soft-danger icon-action"><i class="ri-delete-bin-line" /></a>
                                    </td>
                                </tr>
                            }
                        }

                        <!-- end tr -->
                    </tbody><!-- end tbody -->
                </table><!-- end table -->
            </div>

            <Pagination PaginatedData="Customers" OnPageChanged="OnPageChanged" />
        </div>

        
    </div>
</div>

<style>
    .table-card-company {
        margin-left: -16px;
        margin-right: -16px;
        height: calc(100vh - 320px) !important;
        max-height: calc(100vh - 320px) !important;
    }
    
    tbody {
        overflow-y: auto !important;
    }

    tbody tr:nth-child(even) {        
        background-color: #f3f6f9;
    }

    th {
        position: sticky;
        top: 0;
        z-index: 1;
    }


    td a {
        color: var(--vz-table-color);              
        padding: 0.24rem !important;          
        @* background-color: aqua; *@
    }

    td a:hover {
        color: var(--vz-table-color);                                
        border: 0.01rem solid var(--vz-table-color);
        padding: 0.23rem 0.18rem !important;          
        background-color: lightgray;
        opacity: 0.7;
        border-radius: 5px;
    }

    table td {
        padding: 0.50rem !important;
    }

    table td:hover {
        @* padding: 0.39rem !important; *@
    }

    .icon-action{
        width: 30px;
        height: 30px;
        font-size: 0.756rem;
    }


</style>

@code {
    private IPaginatedList<Customer> Customers { get; set; }
    private int PageIndex = 1;
    private int PageSize = 12;
    private ApplicationUser User;

    private string SearchWord { get; set; }

    protected async override Task OnInitializedAsync()
    {
        await LoadAuthenticatedUserAsync();
        await LoadDataAsync();
    }

    private async Task LoadAuthenticatedUserAsync()
    {        
        var userId = (await AuthenticationHelper.GetAuthenticatedUserIdAsync(AuthProvider))!.Value;

        if (userId != Guid.Empty)
            User = await ApplicationUserService.FindByIdAsync(userId);
    }


    private async Task OnPageChanged(int pageNumber)
    {
        PageIndex = pageNumber;
        await LoadDataAsync();
        StateHasChanged();
    }


    private async Task LoadDataAsync()
    {
        if (User == null)
            return;

        Customers = await CustomerService.ListAsync((Guid)User.CompanyId, PageIndex, PageSize, SearchWord);
    }

    private async Task OnSearch()
    {
        Console.WriteLine("OnSearch...");       
        PageIndex = 1;
        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task OnInput()
    {
        if (SearchWord.Length > 3 || SearchWord.Length == 0) {
            await LoadDataAsync();
            StateHasChanged();
        }
    }
}
