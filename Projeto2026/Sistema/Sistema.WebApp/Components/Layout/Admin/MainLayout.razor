
@inherits ComponentPageBase

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>
    <MudAppBar Color="Color.Primary" Elevation="1">        
        <NavBar OnToggleDrawer="ToggleDrawer" />
    </MudAppBar>

    <MudDrawer ClipMode="DrawerClipMode.Never" Elevation="1" Variant="DrawerVariant.Mini" Open="@_drawerOpen" >
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        <div class="px-4 py-4">
            @Body
        </div>
    </MudMainContent>

    @*<MudFooter Elevation="1">
        Desenvolvido por NineGoldy Soluções
    </MudFooter>*@
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {

    private bool _drawerOpen = true;

    private async void ToggleDrawer(object sender, EventArgs e)
    {
        _drawerOpen = !_drawerOpen;
        StateHasChanged();
    }

    protected async override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            
        }
    }
}
