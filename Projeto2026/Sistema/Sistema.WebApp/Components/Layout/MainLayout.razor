@inherits LayoutComponentBase

<FluentLayout>

    <FluentLayoutItem Area="@LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Content">
        <FluentStack Orientation="Orientation.Vertical">
            <FluentLayout>
                <FluentLayoutItem Area="@LayoutArea.Header">
                    <h1>barra</h1>
                </FluentLayoutItem>

                <FluentLayoutItem Area="@LayoutArea.Content" Padding="@Padding.All2">
                    @Body
                </FluentLayoutItem>

            </FluentLayout>           
        </FluentStack>
        

    </FluentLayoutItem>

    <FluentLayoutItem Area="@LayoutArea.Footer">
        Desenvolvido por NineGoldy Soluções
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
