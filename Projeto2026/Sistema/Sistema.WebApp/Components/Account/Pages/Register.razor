@page "/account/register"

@inherits ComponentPageBase
@layout Components.Account.Layout.DefaultLayout
@inject IAuthService AuthService

<PageTitle>Cadastro de Usuário</PageTitle>

<div class="d-flex flex-column">
    <div>
        <h5 class="text-primary">Criar uma conta!</h5>
        <p class="text-secondary">Registre um acesso ao sistema</p>
    </div>

    <div>
        <EditForm Model="@Model" OnValidSubmit="RegisterUserAsync" method="POST" FormName="@FormName">
            <DataAnnotationsValidator />          

            <MudFocusTrap class="d-flex flex-column" DefaultFocus="DefaultFocus.FirstChild">
                <div>                    
                    <label for="email" class="mt-2">E-mail</label>
                    <AppTextField id="email" @bind-Value="@Model.Email" Placeholder="Digite o e-mail" />
                    <ValidationMessage For="() => Model.Email" class="invalid-feedback" />
                </div>

                <div>
                    <label for="password" class="mt-2">Senha</label>
                    <AppPasswordField id="password" @bind-Value="@Model.Password" Placeholder="Digite a senha"fs />
                    <ValidationMessage For="() => Model.Password" class="invalid-feedback" />
                </div>

                <div>
                    <label for="confirmpassword" class="mt-2">Confirme a Senha</label>
                    <AppPasswordField id="confirmpassword" @bind-Value="@Model.ConfirmPassword" Placeholder="Confirme a senha" />
                    <ValidationMessage For="() => Model.ConfirmPassword" class="invalid-feedback" />
                </div>

                <MudStack AlignItems="AlignItems.Center" class="mt-4"> 
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary">Cadastrar</MudButton>                    
                </MudStack>
            </MudFocusTrap>
        </EditForm>

    </div>

</div>


@code {

    private const string FormName = "register-form";

    [SupplyParameterFromForm(FormName = FormName)]
    private UserRequest Model { get; set; } = new();    

    private async Task RegisterUserAsync(EditContext editContext)
    {
        var user = await AuthService.RegisterUserAsync(Model);

        if (user != null)
            NavigationManager.NavigateTo("/account/login");
    }    
}
