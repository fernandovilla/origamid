@inherits LayoutComponentBase


<div class="auth-page-wrapper auth-bg-cover auth-card">
    <div class="bg-overlay">
    </div>
    <FluentCard Width="50%" Height="50%">
        <FluentStack Height="100%">
            <div>A</div>
            <FluentSpacer />
            <FluentDivider Vertical="true" />
            <FluentSpacer />
            <div>
                @Body
            </div>
        </FluentStack>

    </FluentCard>
</div>

<style>
    .auth-page-wrapper {        
        padding-bottom: 40px;
        position: relative;
        z-index: 2;
        width: 100%;       
    }

    .auth-bg-cover {
        background: linear-gradient(45deg, #405189 40%, #0ab39d)
    }

        .auth-bg-cover > .bg-overlay {

            background-image: url(~/images/cover-pattern.png);
            background-position: center;
            background-size: cover;
            opacity: 1;
            background-color: transparent;
        }

        .auth-bg-cover .footer {
            color: rgba(255,255,255,.5)
        }

    .auth-card {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100vw;
        height: 100vh;
    }
</style>

