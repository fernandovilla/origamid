@page "/counter"
@using PostgreEF.Web.Client.Components.Focustrap

<PageTitle>Counter</PageTitle>

<h1>Counter</h1>



<Focustrap>
    <form>
        <div class="row mb-2">
            <div class="mb-3 col-2">
                <lab for="id" class="form-label">ID</lab>
                <input id="id" class="form-control" @bind-value="User.Id" />
            </div>

            <div class="mb-3 col-2">
                <lab for="id" class="form-label">Nome</lab>
                <input id="id" class="form-control" @bind-value="User.Name" />
            </div>
        </div>

    
        <div class="row">
            <div class="col-2">
                <p role="status">Current count: @currentCount</p>
                <button type="button" class="btn btn-primary" @onclick="IncrementCount">Click me</button>
            </div>
        </div>
    </form>
</Focustrap>


<div class="row mt-3">
    <div class="col-3">
        <lab for="outro" class="form-label">Outro Input</lab>
        <input id="outro" class="form-control" />
    </div>
</div>




@code {
    private PostgreEF.Domain.Model.User User { get; set; } = new();

    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }
}
