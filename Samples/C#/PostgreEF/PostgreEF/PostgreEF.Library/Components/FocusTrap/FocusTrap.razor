@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_containerRef" id="@_elementId" class="@Class" style="@Style">
    @ChildContent
</div>

@code {
    /// <summary>Conteúdo que ficará "preso" dentro do trap de foco.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Controla a ativação do trap. Suporta binding bidirecional:
    /// &lt;FocusTrap @bind-Active="_ativo"&gt;
    /// Quando o usuário pressiona Esc ou clica fora (conforme Options),
    /// o valor é atualizado automaticamente via ActiveChanged.
    /// </summary>
    [Parameter] public bool Active { get; set; }
    [Parameter] public EventCallback<bool> ActiveChanged { get; set; }

    /// <summary>Opções repassadas 1:1 para createFocusTrap(element, options).</summary>
    [Parameter] public FocusTrapOptions? Options { get; set; }

    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Style { get; set; }

    private ElementReference _containerRef;
    private readonly string _elementId = $"focus-trap-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<FocusTrap>? _dotNetRef;
    private bool _trapCreated;
    private bool _lastActive;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Ajuste o caminho abaixo conforme onde o arquivo focusTrap.js
            // acabar ficando no seu projeto (veja README.md).
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/PostgreEF.Library/js/focusTrap.js");

            _dotNetRef = DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync("createTrap", _elementId, _containerRef, Options, _dotNetRef);

            _trapCreated = true;
            _lastActive = Active;

            if (Active)
            {
                await _module.InvokeVoidAsync("activate", _elementId);
            }

            return;
        }

        // Reage a mudanças externas no parâmetro Active (ex.: pai fazendo
        // aberto = true para abrir um modal).
        if (_trapCreated && Active != _lastActive)
        {
            _lastActive = Active;

            if (Active)
                await _module!.InvokeVoidAsync("activate", _elementId);
            else
                await _module!.InvokeVoidAsync("deactivate", _elementId);
        }
    }

    /// <summary>Chamado pelo JS quando o focus-trap dispara onActivate.</summary>
    [JSInvokable]
    public async Task HandleActivate()
    {
        _lastActive = true;
        if (!Active)
            await ActiveChanged.InvokeAsync(true);
    }

    /// <summary>
    /// Chamado pelo JS quando o focus-trap dispara onDeactivate
    /// (ex.: usuário apertou Esc ou clicou fora, conforme Options).
    /// </summary>
    [JSInvokable]
    public async Task HandleDeactivate()
    {
        _lastActive = false;
        if (Active)
            await ActiveChanged.InvokeAsync(false);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("destroy", _elementId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // O circuito já caiu (navegação/fechamento de aba) — nada a fazer.
            }
        }

        _dotNetRef?.Dispose();
    }
}
