<div class="child">
    <h3>Counter Child</h3>
    <p>Current Count: @Count</p>
    
    <button class="btn btn-primary" @onclick="IncrementCount">Click me</button>
</div>



<style>
    .child {
        border: 1px solid black;
        padding: 10px;
    }
</style>

@code {
    [Parameter]
    public int Count { get; set; }

    [Parameter]
    public EventCallback IncrementParentEvent { get; set; }

    private void IncrementCount()
    {
        //Count++;
        IncrementParentEvent.InvokeAsync();        
    }
}
