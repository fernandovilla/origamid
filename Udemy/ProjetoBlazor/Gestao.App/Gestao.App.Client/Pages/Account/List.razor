        * Blazor Server, obtem o usuário de SignInManager
        * Blazor WASM, obtem o usuário de AuthenticationStateProvider
        */

        //UserId = (await AuthenticationHelper.GetAuthenticatedUserIdAsync(AuthProvider))!.Value;
    }
}
