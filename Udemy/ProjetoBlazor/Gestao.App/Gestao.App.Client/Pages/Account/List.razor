@page "/account/list"

@attribute [Authorize]
@rendermode InteractiveAuto
@inject AuthenticationStateProvider AuthProvider
@inject IAccountRepository AccountRepository
@inject ILocalStorageService LocalStorage

<PageTitle>
    Empresas
</PageTitle>

<div class="card">

    <div class="card-header align-items-center d-flex">

        <h4 class="card-title mb-0 flex-grow-1">
            <i class="ri-safe-2-line me-1" />Contas
        </h4>
        <div class="flex-shrink-0">
            <a href="/account/edit" class="btn btn-info btn-sm material-shadow-none">
                <i class="ri-add-circle-line me-1" />nova conta
            </a>
        </div>
    </div><!-- end card header -->

    <div class="card-body">

        <!-- Pesquisa -->
        <div class="col-lg-8">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Digite sua pesquisa" @bind="SearchWord">
                <button class="btn btn-outline-success" type="button"><i class="ri-search-line" @onclick="OnSearch" /></button>
            </div>
        </div>

        <div class="table-responsive mt-4 table-card-company">
            <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                <thead class="text-muted table-light">
                    <tr>
                        <th scope="col">Descrição</th>
                        <th scope="col">Data Início</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Accounts == null)
                    {
                        <tr>
                            <td colspan="4">Carregando...</td>
                        </tr>
                    }
                    else if (Accounts.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="4">Nenhuma conta cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var account in Accounts.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@account.Description</strong>
                                </td>
                                <td>
                                    @account.BalanceDate.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    <a href="/account/edit/@account.Id" class="btn btn-sm btn-soft-info"><i class="ri-edit-line" /></a>
                                    <a href="/account/detail/@account.Id" class="btn btn-sm btn-soft-danger"><i class="ri-delete-bin-line" /></a>
                                </td>
                            </tr>
                        }
                    }

                    <!-- end tr -->
                </tbody><!-- end tbody -->
            </table><!-- end table -->
        </div>

        @if (Accounts != null)
        {
            <Pagination PaginatedData="Accounts" OnPageChanged="OnPageChanged" />
        }
    </div>

	
</div>

<style>
    .table-card-company {
        margin-left: -16px;
        margin-right: -16px;
    }
</style>


@code {
    private PaginatedList<Account>? Accounts = null;

    //private Guid UserId;
    private string SearchWord = string.Empty;
    private int PageSize = 15;
    private int PageIndex = 1;
    private Company? Company = null;

    private async Task OnSearch()
    {
        PageIndex = 1;
        await LoadDataAsync();
    }

    private async Task OnPageChanged(int pageNumber)
    {
        PageIndex = pageNumber;
        await LoadDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        //await LoadAuthenticatedUserAsync();
        //await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadDataAsync();
        StateHasChanged();
    }

    private async Task LoadDataAsync()
    {
        if (Company == null)
            Company = await LocalStorage.GetItemAsync<Company>(AppConstants.LOCAL_STORAGE_COMPANY);

        if (Company != null)
            Accounts = await AccountRepository.GetAllAsync(Company!.Id, PageIndex, PageSize, SearchWord);

        
    }

    private async Task LoadAuthenticatedUserAsync()
    {
        //Carregar as empresas cadastradas...
