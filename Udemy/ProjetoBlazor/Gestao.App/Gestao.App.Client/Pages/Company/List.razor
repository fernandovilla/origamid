@page "/Company/List"

@* @using Gestao.App.Client.Components *@
@attribute [Authorize]
@rendermode InteractiveAuto
@inject ICompanyRepository CompanyRepository;
@inject AuthenticationStateProvider authProvider;

<PageTitle>
    Empresas
</PageTitle>

<div class="card">

    <div class="card-header align-items-center d-flex">

        <h4 class="card-title mb-0 flex-grow-1">
            <i class="ri-building-4-line me-1" />Empresas
        </h4>
        <div class="flex-shrink-0">
            <a href="/company/edit" class="btn btn-info btn-sm material-shadow-none">
                <i class="ri-add-circle-line me-1" />nova empresa
            </a>
        </div>
    </div><!-- end card header -->

    <div class="card-body">

        <!-- Pesquisa -->
        <div class="col-lg-8">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Digite sua pesquisa" @bind="SearchWord">
                <button class="btn btn-outline-success" type="button"><i class="ri-search-line" @onclick="OnSearch" /></button>
            </div>
        </div>

        <div class="table-responsive mt-4 table-card-company">
            <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                <thead class="text-muted table-light">
                    <tr>
                        <th scope="col">Nome Fantasia</th>
                        <th scope="col">CNPJ</th>
                        <th scope="col">Endereço</th>
                        <th scope="col">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Companies == null)
                    {
                        <tr>
                            <td colspan="4">Careggando...</td>
                        </tr>
                    }
                    else if (Companies.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="4">Nenhuma empresa cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var company in Companies.Items)
                        {
                            <tr>
                                <td>
                                    <strong>@company.TradeName</strong>
                                </td>
                                <td>
                                    @company.TaxId
                                </td>
                                <td>
                                    @company.Address
                                </td>

                                <td>
                                    <a href="#" class="btn btn-sm btn-soft-success"><i class="ri-check-line me-1" />Selecionar</a>
                                    <a href="/company/edit/@company.Id" class="btn btn-sm btn-soft-info"><i class="ri-edit-line" /></a>
                                    <a href="/company/detail/@company.Id" class="btn btn-sm btn-soft-danger"><i class="ri-delete-bin-line" /></a>
                                </td>
                            </tr>
                        }
                    }

                    <!-- end tr -->
                </tbody><!-- end tbody -->
            </table><!-- end table -->
        </div>

        <Pagination PaginatedData="Companies" OnPageChanged="OnPageChanged" />
    </div>

	
</div>

<style>
    .table-card-company {
        margin-left: -16px;
        margin-right: -16px;
    }
</style>


@code {
    private PaginatedList<Company>? Companies = null;

    private Guid UserId;
    private string SearchWord = string.Empty;
    private int PageSize = 15;
    private int PageIndex = 1;

    private async Task OnSearch()
    {
        PageIndex = 1;
        await LoadDataAsync();
    }

    private async Task OnPageChanged(int pageNumber)
    {
        PageIndex = pageNumber;
        await LoadDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthenticatedUserAsync();

        await LoadDataAsync();

    }

    private async Task LoadDataAsync()
    {
        Companies = await CompanyRepository.GetAllAsync(UserId, PageIndex, PageSize, SearchWord);
    }

    private async Task LoadAuthenticatedUserAsync()
    {
        //Carregar as empresas cadastradas...
        /*
        * Blazor Server, obtem o usuário de SignInManager
        * Blazor WASM, obtem o usuário de AuthenticationStateProvider
        */

        UserId = (await AuthenticationHelper.GetAuthenticatedUserIdAsync(authProvider))!.Value;
    }
}
