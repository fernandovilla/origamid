@page "/Company/List"

@attribute [Authorize]
@rendermode InteractiveAuto

<div class="card">

    <div class="card-header align-items-center d-flex">
        
        <h4 class="card-title mb-0 flex-grow-1"> 
            <i class="ri-building-4-line me-1" />Empresas
        </h4>
        <div class="flex-shrink-0">
            <button type="button" class="btn btn-info btn-sm">
                <i class="ri-add-circle-line me-1" />nova empresa
            </button>
        </div>
    </div><!-- end card header -->

    <div class="card-body">

        <!-- Pesquisa -->
        <div class="col-lg-8">
            <div class="input-group">
                <input type="text" class="form-control" aria-label="Recipient's username" aria-describedby="button-search" placeholder="Digite sua pesquisa">
                <button class="btn btn-outline-success" type="button" id="button-search"><i class="ri-search-line" /></button>
            </div>
        </div>

        <div class="table-responsive mt-4 table-card-company">
            <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                <thead class="text-muted table-light">
                    <tr>
                        <th scope="col">Nome Fantasia</th>
                        <th scope="col">CNPJ</th>
                        <th scope="col">Endereço</th>
                        <th scope="col">Ação</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>
                            Mercado Costa
                        </td>
                        <td>
                            07.123.222/0001-21
                        </td>
                        <td>
                            Rua José Crocci, 850
                        </td>
                        
                        <td>
                            <a href="#" class="btn btn-sm btn-soft-success"><i class="ri-check-line" /></a>
                            <a href="#" class="btn btn-sm btn-soft-info"><i class="ri-edit-line" /></a>
                            <a href="#" class="btn btn-sm btn-soft-danger"><i class="ri-delete-bin-line" /></a>
                        </td>
                    </tr><!-- end tr -->                    
                </tbody><!-- end tbody -->
            </table><!-- end table -->
        </div>


        <!--Paginação-->
        <div class="align-items-center mt-4 pt-2 justify-content-between row text-center text-sm-start">
            <div class="col-sm">
                <div class="text-muted">
                    Listando <span class="fw-semibold">5</span> de <span class="fw-semibold">25</span> registros.
                </div>
            </div>
            <div class="col-sm-auto  mt-3 mt-sm-0">
                <ul class="pagination pagination-separated pagination-sm mb-0 justify-content-center">
                    <li class="page-item disabled">
                        <a href="#" class="page-link">←</a>
                    </li>
                    <li class="page-item">
                        <a href="#" class="page-link">1</a>
                    </li>
                    <li class="page-item active">
                        <a href="#" class="page-link">2</a>
                    </li>
                    <li class="page-item">
                        <a href="#" class="page-link">3</a>
                    </li>
                    <li class="page-item">
                        <a href="#" class="page-link">→</a>
                    </li>
                </ul>
            </div>
        </div>
    </div>

	
</div>

<style>
    .table-card-company {
        margin-left: -16px;
        margin-right: -16px;
    }
</style>


