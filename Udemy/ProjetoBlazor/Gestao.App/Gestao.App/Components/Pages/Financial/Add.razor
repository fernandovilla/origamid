@page "/financial/{type}/add"

@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime js
@inject IFinancialTransactionRepository FinancialRepository

<PageTitle>
    Transação Financeira - Edição
</PageTitle>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">
                    @($"Edição de Conta {(TypeEnum == FinancialTransactionTypeEnum.Pay ? "à Pagar" : "À Receber")}")
                </h4>
            </div>
            <div class="card-body">
                <FinancialTransactionForm TypeEnum="TypeEnum" IsEditForm="@false" OnSaving="OnSavingAsync" />
            </div>
        </div>
    </div>
</div>


@code {    
    [Parameter]
    public string? Type { get; set; }

    private FinancialTransactionTypeEnum TypeEnum => Type?.ToUpper() == "PAY" ? FinancialTransactionTypeEnum.Pay : FinancialTransactionTypeEnum.Receive;

    

    private async Task OnSavingAsync(FinancialTransaction financialTransaction)
    {
        if (financialTransaction == null)
            return;

        await FinancialRepository.AddAsync(financialTransaction);
        await js.InvokeVoidAsync("alert", "Transação registrada com sucesso!");

        NavigationManager.NavigateTo($"/financial/{Type}/list");
    }

}
