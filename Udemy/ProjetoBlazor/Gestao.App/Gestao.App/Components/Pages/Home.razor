@page "/"

@inherits PageBase
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<div class="row">
    <Totalizadores />

    <AccountBalance />
</div>

<div class="row">
    <AccessLink />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var company = await LocalStorage.GetItemAsync<Gestao.Domain.Model.Company>(AppConstants.LOCAL_STORAGE_COMPANY);

        if (company == null)
            NavigationManager.NavigateTo("/company/list");
    }
}