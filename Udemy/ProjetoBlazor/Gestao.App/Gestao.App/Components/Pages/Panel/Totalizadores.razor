@inherits PageBase

<div class="col-xl-3 col-md-6">
    <!-- Financial Transaction Indicadores - START -->

    <div class="card card-animate">
        <div class="card-body">
            <div class="d-flex align-items-center">
                <div class="flex-grow-1 overflow-hidden">
                    <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Total Recebido</p>
                </div>
                <div class="flex-shrink-0">
                    <h5 class="text-success fs-14 mb-0">
                        <i class="ri-arrow-right-up-line fs-13 align-middle"></i> +16.24 %
                    </h5>
                </div>
            </div>
            <div class="d-flex align-items-end justify-content-between mt-4">
                <div>
                    <h4 class="fs-22 fw-semibold ff-secondary mb-4">
                        <span class="counter-value" data-target="559.25">
                            @TotalFinancialTransactionReceived.ToString("C")
                        </span>
                    </h4>
                    <a href="/financial/receive/list" class="text-decoration-underline">Ver detalhes</a>
                </div>
                <div class="avatar-sm flex-shrink-0">
                    <span class="avatar-title bg-success-subtle rounded fs-3">
                        <i class="bx bx-dollar-circle text-success"></i>
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-animate">
        <div class="card-body">
            <div class="d-flex align-items-center">
                <div class="flex-grow-1 overflow-hidden">
                    <p class="text-uppercase fw-medium text-muted text-truncate mb-0">Total Pago</p>
                </div>
                <div class="flex-shrink-0">
                    <h5 class="text-muted fs-14 mb-0">
                        +0.00 %
                    </h5>
                </div>
            </div>
            <div class="d-flex align-items-end justify-content-between mt-4">
                <div>
                    <h4 class="fs-22 fw-semibold ff-secondary mb-4">
                        <span class="counter-value" data-target="@TotalFinancialTransactionPayed">
                            @TotalFinancialTransactionPayed.ToString("C")
                        </span>
                    </h4>
                    <a href="/financial/pay/list" class="text-decoration-underline">Ver detalhes</a>
                </div>
                <div class="avatar-sm flex-shrink-0">
                    <span class="avatar-title bg-primary-subtle rounded fs-3">
                        <i class="bx bx-wallet text-primary"></i>
                    </span>
                </div>
            </div>
        </div><!-- end card body -->
    </div>

</div> <!-- Financial Transaction Indicadores - END -->
@code {

    private Company? Company { get; set; }
    private decimal TotalFinancialTransactionPayed { get; set; } = 0m;
    private decimal TotalFinancialTransactionReceived { get; set; } = 0m;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadCompanyAsync();

        await LoadTotalFinancialTransactionPayedAsync();

        await LoadTotalFinancialTransactionReceivedAsync();

        StateHasChanged();
    }

    private async Task LoadCompanyAsync()
    {
        var company = await LocalStorage.GetItemAsync<Company>(AppConstants.LOCAL_STORAGE_COMPANY);

        if (company != null)
            Company = company;
    }

    private async Task LoadTotalFinancialTransactionPayedAsync()
    {
        if (Company == null)
            return;

        var value = DbContext.FinancialTransactions
            .Where(i => i.FinancialTransactionType == FinancialTransactionTypeEnum.Pay)
            .Where(i => Company == null || i.CompanyId == Company.Id)
            .Sum(i => i.AmountPaid);

        if (value.HasValue)
            TotalFinancialTransactionPayed = value.Value;
        else
            TotalFinancialTransactionPayed = 0m;
    }

    private async Task LoadTotalFinancialTransactionReceivedAsync()
    {
        if (Company == null)
            return;

        var value = DbContext.FinancialTransactions
            .Where(i => i.FinancialTransactionType == FinancialTransactionTypeEnum.Receive)
            .Where(i => Company == null || i.CompanyId == Company.Id)
            .Sum(i => i.AmountPaid);

        if (value.HasValue)
            TotalFinancialTransactionReceived = value.Value;
        else
            TotalFinancialTransactionReceived = 0m;
    }


}