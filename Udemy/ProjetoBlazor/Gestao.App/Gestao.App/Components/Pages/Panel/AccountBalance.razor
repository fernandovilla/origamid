@inherits PageBase

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<div class="col-xl-9">
    <!-- Accounts Table - START -->
    <div class="card">
        <div class="card-header align-items-center d-flex">
            <h4 class="card-title mb-0 flex-grow-1">Saldo das Contas</h4>
            <div class="flex-shrink-0">
                <button type="button" class="btn btn-soft-info btn-sm">
                    <i class="ri-file-list-3-line align-middle"></i> Gerar Relatório
                </button>
            </div>
        </div>

        <div class="card-body">
            <div class="table-responsive table-card">
                <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                    <thead class="text-muted table-light">
                        <tr>
                            <th scope="col">Descrição</th>
                            <th scope="col">Saldo Inicial</th>
                            <th scope="col">Total Pago</th>
                            <th scope="col">Total Recebido</th>
                            <th scope="col">Saldo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (BalanceReport.Count == 0)
                        {
                            <tr>
                                <td>Não há operações à serem listadas</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var report in BalanceReport)
                            {
                                <tr>
                                    <td>@report.Description</td>
                                    <td>@report.InitialBalance.ToString("C")</td>
                                    <td class="text-danger">@report.TotalPaid.ToString("C")</td>
                                    <td class="text-success">@report.TotalReceived.ToString("C")</td>
                                    <td>
                                        @if (report.Balance > 0)
                                        {
                                            <span class="badge bg-success-subtle text-success">@report.Balance.ToString("C")</span>
                                        }
                                        else if (report.Balance < 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger">@report.Balance.ToString("C")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info" >@report.Balance.ToString("C")</span>
                                        }                                                                                
                                    </td>
                                </tr>
                            }
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<!-- Accounts Table - END -->
@code {
    private Company? Company { get; set; }
    private List<AccountBalanceReportViewModel> BalanceReport { get; set; } = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadCompanyAsync();

        await LoadAccountBalanceReport();

        StateHasChanged();
    }

    private async Task LoadCompanyAsync()
    {
        var company = await LocalStorage.GetItemAsync<Company>(AppConstants.LOCAL_STORAGE_COMPANY);

        if (company != null)
            Company = company;
    }

    private async Task LoadAccountBalanceReport()
    {
        BalanceReport = new();

        if (Company == null)
            return;

        using var db = await DbContextFactory.CreateDbContextAsync();

        var balanceCompany = await db.Accounts
            .Where(i => i.CompanyId == Company.Id)
            .Include(i => i.FinancialTransactions)
            .Select(i => new AccountBalanceReportViewModel
            {
                Description = i.Description,
                InitialBalance = i.Balance,
                TotalPaid = i.FinancialTransactions != null ? i.FinancialTransactions
                   .Where(i => i.FinancialTransactionType == FinancialTransactionTypeEnum.Pay)
                   .Sum(i => i.AmountPaid) ?? 0m : 0m,
                TotalReceived = i.FinancialTransactions != null ? i.FinancialTransactions
                   .Where(i => i.FinancialTransactionType == FinancialTransactionTypeEnum.Receive)
                   .Sum(i => i.AmountPaid) ?? 0m : 0m,
            }).ToListAsync();


        if (balanceCompany != null)
            BalanceReport = balanceCompany;
    }


    public class AccountBalanceReportViewModel
    {
        public string Description { get; set; } = string.Empty;
        public decimal InitialBalance { get; set; } = 0m;
        public decimal TotalPaid { get; set; } = 0m;
        public decimal TotalReceived { get; set; } = 0m;
        public decimal Balance => (InitialBalance + TotalReceived) - TotalPaid;
    }

}