        <a class="nav-link menu-link" href="#sidebarLayouts" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarLayouts">
            <i class="ri-layout-3-line"></i>
            <span data-key="t-layouts">Contas</span>
            @* <span class="badge badge-pill bg-danger" data-key="t-hot">Hot</span> *@
        </a>
        <div class="collapse menu-dropdown" id="sidebarLayouts">
            <ul class="nav nav-sm flex-column">
                <li class="nav-item">
                    <a href="layouts-horizontal.html" target="_blank" class="nav-link" data-key="t-horizontal">Receber</a>
                </li>
                <li class="nav-item">
                    <a href="layouts-detached.html" target="_blank" class="nav-link" data-key="t-detached">Pagar</a>
                </li>                
            </ul>
        </div>
    </li> 
    <!-- END CONTAS MENU -->

</ul>





