@implements IDisposable

@inject NavigationManager NavigationManager

<ul class="navbar-nav" id="navbar-nav">
    <li class="menu-title"><span data-key="t-menu">Menu</span></li>

    <!-- START PAINEL MENU -->
    <li class="nav-item">
        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
            <i class="ri-dashboard-2-line"></i> <span data-key="t-painel">Painel</span>
        </NavLink>
    </li>
    <!-- END PAINEL MENU -->
    <!-- START CADASTRO MENU -->
    <li class="nav-item">
        <a class="nav-link menu-link" href="#sidebarCadastro" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarDashboards">
            <i class="ri-file-list-3-line"></i>
            <span data-key="t-cadastro">Cadastro</span>
        </a>
        <div class="collapse menu-dropdown" id="sidebarCadastro">
            <ul class="nav nav-sm flex-column">

                
                <li class="nav-item">
                    <NavLink class="nav-link" href="/Company/List">Empresa</NavLink>
                </li>

                @if (companySelected)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/Account/List">Conta</NavLink>
                    </li>

                    <li class="nav-item">
                        <NavLink class="nav-link" href="/Category/List">Categoria</NavLink>
                    </li>
                }                
            </ul>
        </div>
    </li>
    <!-- END CADASTRO MENU -->

    <!-- START CONTAS MENU -->
    @if (companySelected)
    {
        <li class="nav-item">
            <a class="nav-link menu-link" href="#sidebarContas" data-bs-toggle="collapse" role="button" aria-expanded="false" aria-controls="sidebarLayouts">
                <i class="ri-money-dollar-circle-line"></i>
                <span data-key="t-contas">Contas</span>
            </a>
            <div class="collapse menu-dropdown" id="sidebarContas">
                <ul class="nav nav-sm flex-column">
                    <li class="nav-item">
                        <NavLink href="/AccountManagement/Pay/List" class="nav-link" data-key="t-pay">Pagar</NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink href="/AccountManagement/Receive/List" class="nav-link" data-key="t-receive">Receber</NavLink>
                    </li>
                </ul>
            </div>
        </li>
    }
    <!-- END CONTAS MENU -->

</ul>


                
@code {
    private string? currentUrl;
    private bool companySelected = false;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

