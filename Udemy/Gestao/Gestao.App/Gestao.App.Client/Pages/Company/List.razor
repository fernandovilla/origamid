@page "/company/list"

@attribute [Authorize]
@rendermode InteractiveAuto
@inject ICompanyRepository CompanyRepository
@inject ILocalStorageService LocalStorage
@inject ICompanySelectNotification CompanySelectNotification
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JSRuntime

<PageTitle>
    Empresas
</PageTitle>

<div class="card">

    <div class="card-header align-items-center d-flex">

        <h4 class="card-title mb-0 flex-grow-1">
            <i class="ri-building-4-line me-1" />Empresas
        </h4>
        <div class="flex-shrink-0">
            <a href="/company/edit" class="btn btn-info btn-sm material-shadow-none">
                <i class="ri-add-circle-line me-1" />nova empresa
            </a>
        </div>
    </div><!-- end card header -->

    <div class="card-body">

        <!-- Pesquisa -->
        <div class="col-lg-8">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Digite sua pesquisa" @bind="SearchWord">
                <button class="btn btn-outline-success" type="button"><i class="ri-search-line" @onclick="OnSearch" /></button>
            </div>
        </div>

        <div class="table-responsive mt-4 table-card-company">
            <table class="table table-borderless table-centered align-middle table-nowrap mb-0">
                <thead class="text-muted table-light">
                    <tr>
                        <th scope="col">Nome Fantasia</th>
                        <th scope="col">CNPJ</th>
                        <th scope="col">Endereço</th>
                        <th scope="col">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Companies == null)
                    {
                        <tr>
                            <td colspan="4">Carregando...</td>
                        </tr>
                    }
                    else if (Companies.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="4">Nenhuma empresa cadastrada</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var company in Companies.Items)
                        {
                            <tr>
                                <td>
                                    @company.TradeName
                                    @if (CompanySelected != null && CompanySelected.Id == company.Id)
                                    {
                                        <span class="badge badge-label bg-success mx-3" data-key="t-hot">SELECIONADA</span>
                                    }
                                </td>
                                <td>@company.TaxId</td>
                                <td>@company.Address</td>
                                <td>
                                    @if (CompanySelected != null && CompanySelected.Id == company.Id)
                                    {
                                        <button class="btn btn-sm btn-soft-danger me-1" @onclick="() => RemoveCompanyAsync(company)"><i class="ri-close-line me-1" />Remover</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-soft-success me-1" @onclick="() => SelectCompanyAsync(company)"><i class="ri-check-line me-1" />Selecionar</button>
                                    }
                                    
                                    <a href="/company/edit/@company.Id" class="btn btn-sm btn-soft-info"><i class="ri-edit-line" /></a>
                                    <a href="/company/detail/@company.Id" class="btn btn-sm btn-soft-danger"><i class="ri-delete-bin-line" /></a>
                                </td>
                            </tr>
                        }
                    }

                    <!-- end tr -->
                </tbody><!-- end tbody -->
            </table><!-- end table -->
        </div>

        <Pagination PaginatedData="Companies" OnPageChanged="OnPageChanged" />
    </div>

	
</div>

<style>
    .table-card-company {
        margin-left: -16px;
        margin-right: -16px;
    }
</style>


@code {
    private PaginatedList<Company>? Companies = null;

    private Guid UserId;
    private string SearchWord = string.Empty;
    private int PageSize = 15;
    private int PageIndex = 1;
    private Company? CompanySelected = null;

    private async Task OnSearch()
    {
        PageIndex = 1;
        await LoadDataAsync();
    }

    private async Task OnPageChanged(int pageNumber)
    {
        PageIndex = pageNumber;
        await LoadDataAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthenticatedUserAsync();

        await LoadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await LoadCompanyAsync();
    }

    private async Task LoadDataAsync()
    {
        Companies = await CompanyRepository.GetAllAsync(UserId, PageIndex, PageSize, SearchWord);
    }

    private async Task LoadAuthenticatedUserAsync()
    {        
        UserId = (await AuthenticationHelper.GetAuthenticatedUserIdAsync(AuthProvider))!.Value;
    }

    private async Task LoadCompanyAsync()
    {
        CompanySelected = await LocalStorage.GetItemAsync<Company>(AppConstants.LOCAL_STORAGE_COMPANY);
        StateHasChanged();
    }

    private async Task SelectCompanyAsync(Company company)
    {
        //TODO - ARMAZENAR A TAREFA NO LOCAL STORAGE
        if ((CompanySelected != null && CompanySelected.Id != company.Id) || CompanySelected == null)
        {
            await LocalStorage.SetItemAsync(AppConstants.LOCAL_STORAGE_COMPANY, company);
            CompanySelected = company;
        }

        StateHasChanged();

        //TODO - COMPANYSELECTEDNOTIFICATIONSTATS -> NOTIFICA QUAL EMPRESA FOI SELECIONADA
        CompanySelectNotification.NotificateSelecion(); // apenas notifica que a compania foi selecionada
    }

    private async Task RemoveCompanyAsync(Company company)
    {
        if (CompanySelected == null)
            return;


        var confirm = await JSRuntime.InvokeAsync<bool>("confirm", $"Deseja remover a empresa {company.TradeName}?");
        if (confirm)
        {
            await LocalStorage.RemoveItemAsync(AppConstants.LOCAL_STORAGE_COMPANY);
            CompanySelected = null;
            StateHasChanged();

            CompanySelectNotification.NotificateSelecion(); // apenas notifica que a compania foi selecionada
        }
    }
}
