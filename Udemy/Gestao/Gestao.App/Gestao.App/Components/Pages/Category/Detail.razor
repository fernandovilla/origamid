@page "/category/detail/{id:int}"

@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime js
@inject ICategoryRepository CategoryRepository

<PageTitle>
    Categoria - Detalhe
</PageTitle>

<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header align-items-center d-flex">
                <h4 class="card-title mb-0 flex-grow-1">
                    Detalhes da Categoria
                </h4>

            </div>
            <div class="card-body">

                <div class="row">

                    <div class="col-xxl-6 col-md-6">
                        <div>
                            <label for="description" class="form-label">Descrição/Nome</label>
                            <p>@Category!.Name</p>
                        </div>
                    </div>
                </div>

                <div class="row mt-2">
                    <div class="d-flex justify-content-between">
                        <a href="/category/list" class="btn btn-light">Voltar</a>
                        <button @onclick="OnClickAsync" class="btn btn-danger"><i class="ri-delete-bin-line" />Excluir</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>



@code {

    [Parameter]
    public int Id { get; set; }
    private Category Category { get; set; }


    private async Task OnClickAsync()
    {
        await CategoryRepository.DeleteAsync(Category.Id);

        await js.InvokeVoidAsync("alert", "Categoria excluída com sucesso!");

        NavigationManager.NavigateTo("/category/list");
    }

    
    protected override void OnInitialized()
    {
        Category = new();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id > 0)
        {
            //TODO - SELECIONA OS DADOS DO REPOSITORY
            var category = (await CategoryRepository.GetAsync(Id))!;

            if (category == null)
            {
                NavigationManager.NavigateTo("/category/list");
                return;
            }

            Category = category;
        }
    }
}
