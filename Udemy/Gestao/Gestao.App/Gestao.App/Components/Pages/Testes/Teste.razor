@page "/testes"

@rendermode InteractiveServer

@using System.Drawing
@using Gestao.App.Components.CustomControls.Input

@inherits PageBase

<div class="card">
    <div class="card-header align-items-center d-flex">
        <h4 class="card-title mb-0 flex-grow-1">
            Test Custom Controls
        </h4>
    </div>
    <FocusTrap class="card-body" Active="_modalAberto" OnEscape="FecharModal">
        <EditForm Model="Carro">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row">
                <div class="col-3">
                    <label for="normalInput">Normal Input</label>
                    <input type="text" class="form-control" id="normalInput" @bind-value="Carro.Name" />
                </div>
               
                <div class="col-3">
                    <label for="custoCarro" class="form-label" >Custo Carro R$</label>
                    <InputDecimalBase Id="custoCarro" @bind-Value="Carro.Cost" class="form-control" Format="C2" />
                </div>

                <div class="col-3">
                    <label for="inputColor" class="form-label">InputColor #1</label>
                    <InputColor @bind-Value="Carro.Color" class="form-control" id="inputColor" />
                    <p>Favorite Color: @FavoriteColor </p>
                </div>

            </div>
        </EditForm>
    </FocusTrap>

    <div class="row">
        <button class="btn btn-secondary col-1 me-1">Voltar</button>
        <button class="btn btn-primary col-1">Salvar</button>
    </div>
</div>


@code {
    private Car Carro { get; set; } = new();
    private int Numero { get; set; } = 0;
    private decimal? ValorProduto { get; set; }
    private string ValorCurrency { get; set; } = string.Empty;
    private Color Color { get; set; } = Color.White;
    private string FavoriteColor => InputColor.ColorToString(Color);

    private bool _modalAberto = true;   //True - indica que os elementos podem receber foco de fora ou sair

    private async Task HandleDecimalChanged(decimal? value)
    {
        ValorCurrency = $"Cost was changed to {value}";
    }

    private void FecharModal() => _modalAberto = false;

    public class Car
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public decimal? Cost { get; set; }
        public Color Color { get; set; }
    }

}
